{
  "name": "voyager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply voyager-dev-control --local",
    "db:migrate:remote": "wrangler d1 migrations apply voyager-dev-control --remote",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "dev:backend": "node scripts/dev-local-backend.mjs",
    "dev:cleanup-devices": "node scripts/cleanup-test-devices.mjs",
    "seed": "node scripts/voyager-seed.mjs",
    "client:dev": "npm --prefix apps/client run dev",
    "client:build": "npm --prefix apps/client run build",
    "client:check": "npm --prefix apps/client run check",
    "smoke:backend": "node scripts/backend-first-smoke.mjs",
    "smoke:backend:local": "node scripts/run-local-backend-smoke.mjs",
    "smoke:backend:remote": "node scripts/remote-post-deploy-smoke.mjs",
    "messaging-core:backfill-readonly": "node scripts/voyager-messaging-core-backfill-readonly.mjs",
    "smoke:messaging-core-parity": "node scripts/voyager-messaging-core-parity-smoke.mjs",
    "smoke:tenant-backfill": "node scripts/voyager-tenant-backfill-smoke.mjs",
    "wrangler": "wrangler"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250606.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.103.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "workerd@1.20260617.1": true
  }
}
