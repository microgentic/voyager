{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "673a41a654ed01f9bf90d253ae426a18",
  "name": "voyager-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "workers_dev": true,
  "vars": {
    "CORS_ALLOWED_ORIGINS": "https://voyager-web.pages.dev",
    "VOYAGER_MESSAGING_CORE_TIMEOUT_MS": "15000",
    "VOYAGER_MESSAGING_CORE_IDENTITY_SYNC_TTL_MS": "900000",
    "VOYAGER_MESSAGING_CORE_IDENTITY_SYNC_STALE_GRACE_MS": "3600000",
    "MESSAGING_CORE_BASE_URL": "https://voyager-messaging-worker.microgentic-voyager.workers.dev",
    "MESSAGING_CORE_TENANT_ID": "tenant_voyager_default",
    "MESSAGING_CORE_APP_ID": "voyager",
    "MESSAGING_CORE_TOKEN_ISSUER": "voyager",
    "MESSAGING_CORE_TOKEN_AUDIENCE": "messaging-core",
    "MESSAGING_CORE_INTERNAL_SERVICE_ISSUER": "voyager",
    "MESSAGING_CORE_INTERNAL_SERVICE_AUDIENCE": "messaging-core-internal"
  },
  "migrations": [
    {
      "tag": "v1-realtime-mailbox",
      "new_sqlite_classes": ["RealtimeMailbox"]
    },
    // Retained as append-only Durable Object migration history; v4 deletes it from the current Voyager Worker.
    {
      "tag": "v2-conversation-coordinator",
      "new_sqlite_classes": ["ConversationCoordinator"]
    },
    {
      "tag": "v3-call-coordinator",
      "new_sqlite_classes": ["CallCoordinator"]
    },
    {
      "tag": "v4-delete-conversation-coordinator",
      "deleted_classes": ["ConversationCoordinator"]
    },
    {
      "tag": "v5-delete-voyager-call-runtime",
      "deleted_classes": ["RealtimeMailbox", "CallCoordinator"]
    }
  ],
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "voyager-dev-control",
      "database_id": "f7daaf1f-6584-4bb6-89cd-79ab78d38f97"
    }
  ],
  "services": [
    {
      "binding": "MESSAGING_CORE_SERVICE",
      "service": "voyager-messaging-worker"
    }
  ],
  "observability": {
    "enabled": true
  }
}
