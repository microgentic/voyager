{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "673a41a654ed01f9bf90d253ae426a18",
  "name": "voyager-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "workers_dev": true,
  "vars": {
    "CORS_ALLOWED_ORIGINS": "https://voyager-web.pages.dev"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME_MAILBOX",
        "class_name": "RealtimeMailbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-realtime-mailbox",
      "new_sqlite_classes": ["RealtimeMailbox"]
    }
  ],
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "voyager-dev-control",
      "database_id": "f7daaf1f-6584-4bb6-89cd-79ab78d38f97"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS_BUCKET",
      "bucket_name": "voyager-dev-attachments"
    }
  ],
  "observability": {
    "enabled": true
  }
}
